classDiagram
  Usuario "1" --> "0..*" Prestamo : codUsuario
  Prestamo "1" --> "0..*" DetallePrestamo : codPrestamo
  DetallePrestamo "0..*" --> "1" Libro : codLibro
  Autor "1" --> "0..*" LibroAutor : codAutor
  Libro "1" --> "1" LibroAutor : codLibro
  Categoria "1" --> "0..*" Libro : codCategoria
  class Usuario {
    +String codUser
  }
  class Prestamo {
    +String codPrestamo
    +String codUsuario
  }
  class DetallePrestamo {
    +String codDetallePrestamo
    +int cantPrestamo
  }
  class Libro {
    +String codLibro
    +int cantidadDisponible
  }
  class LibroAutor {
    +String codLibro
    +String codAutor
  }
  class Autor {
    +String codigo
  }
  class Categoria {
    +String codCategoria
  }
